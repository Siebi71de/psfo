{
  "firma": {
    "id": "global_services",
    "name": "Global Services GmbH",
    "beschreibung": "Gemischte Belegschaft, Alt- und Neu-Regelung"
  },
  "versorgungsordnung": {
    "name": "Versorgungsordnung 2010",
    "gueltig_ab": "2010-01-01",
    "stichtag": "2008-01-01",
    "regelung": "gemischt",
    "beschreibung": "Eintritt vor 2008: Alt-Regelung, Eintritt ab 2008: Neu-Regelung",
    "parameter": {
      "satz_pro_jahr": 30.0,
      "prozentsatz": 0.006,
      "teilzeit_standard": true,
      "regelaltersgrenze": 67,
      "vorzeitige_altersgrenze": 63
    },
    "entgeltumwandlung": false,
    "zusagedatum": "2010-01-01",
    "unverfallbarkeit": {
      "rechtsgrundlage": "§ 1b BetrAVG i.V.m. § 30f Abs. 3 BetrAVG",
      "regeln": [
        {
          "id": "entgeltumwandlung",
          "beschreibung": "Entgeltumwandlung: sofort unverfallbar",
          "bedingung": {
            "type": "entgeltumwandlung"
          },
          "rechtsgrundlage": "§ 1b Abs. 5 BetrAVG"
        },
        {
          "id": "neu_ab_2018",
          "beschreibung": "Zusage ab 01.01.2018: Mindestalter 21, Mindestdauer 3 Jahre",
          "bedingung": {
            "type": "zusage_ab",
            "datum": "2018-01-01"
          },
          "mindestalter_bei_zusage": 21,
          "mindestdauer_jahre": 3,
          "rechtsgrundlage": "§ 1b Abs. 1 BetrAVG"
        },
        {
          "id": "uebergang_2001_2017",
          "beschreibung": "Zusage 01.01.2001–31.12.2017: Mindestalter 25, Mindestdauer 5 Jahre",
          "bedingung": {
            "type": "zusage_zwischen",
            "von": "2001-01-01",
            "bis": "2017-12-31"
          },
          "mindestalter_bei_zusage": 25,
          "mindestdauer_jahre": 5,
          "rechtsgrundlage": "§ 30f Abs. 1 BetrAVG"
        },
        {
          "id": "alt_vor_2001",
          "beschreibung": "Zusage vor 01.01.2001: Mindestalter 35, Mindestdauer 10 Jahre (oder 12 Jahre Betriebszugehörigkeit)",
          "bedingung": {
            "type": "zusage_vor",
            "datum": "2001-01-01"
          },
          "mindestalter_bei_zusage": 35,
          "mindestdauer_jahre": 10,
          "alternativ_dienstjahre": 12,
          "rechtsgrundlage": "§ 30f Abs. 3 BetrAVG"
        }
      ]
    },
    "insolvenzdatum": "2024-03-15"
  },
  "schema": {
    "schema_version": "2.0",
    "name": "Global Services GmbH - Gemischte Regelung",
    "input_fields": [
      {
        "id": "eintrittsdatum",
        "label": "Eintrittsdatum",
        "type": "date",
        "required": true,
        "category": "basis",
        "order": 1
      },
      {
        "id": "austrittsdatum",
        "label": "Austrittsdatum",
        "type": "date",
        "required": true,
        "category": "basis",
        "order": 2
      },
      {
        "id": "geburtsdatum",
        "label": "Geburtsdatum",
        "type": "date",
        "required": false,
        "category": "person",
        "order": 3
      },
      {
        "id": "mittlerer_teilzeitfaktor",
        "label": "Mittlerer Teilzeitfaktor",
        "type": "slider",
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "default": 1.0,
        "required": false,
        "category": "berechnung",
        "order": 4,
        "overridable": true,
        "help": "1.0 = Vollzeit, 0.8 = 80%, etc.",
        "visible_in": [
          "einfach"
        ]
      },
      {
        "id": "letztes_gehalt",
        "label": "Letztes Gehalt (EUR/Monat)",
        "type": "number",
        "min": 0.0,
        "max": 50000.0,
        "step": 100.0,
        "default": 0.0,
        "required": true,
        "category": "berechnung",
        "order": 5,
        "help": "Nur bei Neu-Regelung (Eintritt ab 2008) erforderlich",
        "visible_in": [
          "einfach"
        ],
        "conditional": {
          "field": "eintrittsdatum",
          "operator": ">=",
          "value": "2008-01-01"
        }
      }
    ],
    "ui_layout": {
      "modes": [
        {
          "id": "einfach",
          "label": "Einfache Eingabe",
          "description": "Schnelle Eingabe ohne detaillierte Zeiträume",
          "fields": [
            "eintrittsdatum",
            "austrittsdatum",
            "geburtsdatum",
            "mittlerer_teilzeitfaktor",
            "letztes_gehalt"
          ]
        },
        {
          "id": "zeitraum",
          "label": "Zeitraum-Tabelle",
          "description": "Detaillierte Erfassung mit Zeiträumen",
          "fields": [
            "eintrittsdatum",
            "austrittsdatum"
          ],
          "zeitraum_tabelle": {
            "enabled": true,
            "beginn": {
              "type": "max",
              "werte": [
                {
                  "type": "input",
                  "input_id": "eintrittsdatum"
                },
                {
                  "type": "parameter",
                  "parameter_id": "stichtag"
                }
              ],
              "beschreibung": "Erfassungsbeginn"
            },
            "ende": {
              "type": "input",
              "input_id": "austrittsdatum",
              "beschreibung": "Erfassungsende"
            },
            "spalten": [
              {
                "id": "von",
                "label": "Von",
                "type": "date",
                "auto_calculated": true,
                "disabled": true,
                "width": 2
              },
              {
                "id": "bis",
                "label": "Bis",
                "type": "date",
                "required": true,
                "width": 2
              },
              {
                "id": "als_dienstzeit",
                "label": "Als Dienstzeit",
                "type": "checkbox",
                "default": true,
                "width": 1,
                "always_visible": true
              },
              {
                "id": "ggf",
                "label": "GGF",
                "type": "checkbox",
                "default": false,
                "always_visible": true,
                "help": "Gesellschafter-Geschäftsführer (zählt nicht für m)"
              },
              {
                "id": "teilzeitfaktor",
                "label": "Teilzeitfaktor",
                "type": "slider",
                "min": 0.0,
                "max": 1.0,
                "step": 0.05,
                "default": 1.0,
                "always_visible": true,
                "width": 2
              },
              {
                "id": "gehalt",
                "label": "Gehalt (EUR)",
                "type": "number",
                "min": 0.0,
                "max": 50000.0,
                "step": 100.0,
                "default": 0.0,
                "width": 2,
                "always_visible": true
              }
            ]
          }
        }
      ]
    },
    "leistungsteile": [
      {
        "id": "dienstjahre",
        "art": "Berechnungsgrundlage",
        "label": "Dienstjahre",
        "einheit": "Jahre",
        "overridable": true,
        "formula": {
          "type": "function",
          "function_id": "calculate_dienstjahre",
          "inputs": [
            "eintrittsdatum",
            "austrittsdatum",
            "geburtsdatum"
          ]
        }
      },
      {
        "id": "mittlerer_teilzeitfaktor",
        "art": "Berechnungsgrundlage",
        "label": "Mittlerer Teilzeitfaktor",
        "einheit": "Faktor",
        "overridable": true,
        "formula": {
          "type": "zeitraum_aggregation",
          "quelle": "zeitraeume",
          "feld": "teilzeitfaktor",
          "aggregation": "gewichteter_durchschnitt",
          "gewicht": "tage",
          "filter": {
            "feld": "als_dienstzeit",
            "wert": true
          },
          "fallback": {
            "type": "function",
            "function_id": "calculate_avg_teilzeit",
            "inputs": [
              "teilzeit_tabelle"
            ]
          }
        }
      },
      {
        "id": "grundrente_monatlich",
        "art": "Monatliche Rente vorschüssig",
        "label": "Grundrente",
        "einheit": "EUR/Monat",
        "overridable": true,
        "rechtsgrundlage": {
          "dokument": "Versorgungsordnung 2010",
          "paragraf": "§ 2 Abs. 1-2",
          "volltext": "Versorgungsordnung vom 01.01.2010 der Global Services GmbH",
          "beschreibung": "Berechnung nach Alt- oder Neu-Regelung je nach Eintrittsdatum"
        },
        "erster_termin": {
          "type": "calculated",
          "beschreibung": "Erreichen der Regelaltersgrenze",
          "formel": {
            "type": "expression",
            "expression": "add_years(geburtsdatum, regelaltersgrenze)",
            "variables": [
              "geburtsdatum"
            ],
            "parameters": [
              "regelaltersgrenze"
            ]
          }
        },
        "anpassungsregeln": {
          "dynamisierung_vor_rentenbeginn": {
            "aktiviert": true,
            "beschreibung": "3-jährliche Anpassung gemäß VPI",
            "rechtsgrundlage": "§ 10 Abs. 1 VO"
          },
          "dynamisierung_ab_rentenbeginn": {
            "aktiviert": true,
            "beschreibung": "3-jährliche Anpassung gemäß VPI",
            "rechtsgrundlage": "§ 10 Abs. 2 VO"
          },
          "mindestrente": {
            "aktiviert": true,
            "betrag": 350.0,
            "beschreibung": "Garantierte Mindestrente von 350 EUR/Monat"
          }
        },
        "vorzeitige_leistung": {
          "erlaubt": true,
          "beschreibung": "Ab Alter 63 möglich",
          "fruehester_termin": {
            "type": "calculated",
            "formel": {
              "type": "expression",
              "expression": "add_years(geburtsdatum, vorzeitige_altersgrenze)",
              "variables": [
                "geburtsdatum"
              ],
              "parameters": [
                "vorzeitige_altersgrenze"
              ]
            }
          },
          "abschlag": {
            "type": "prozentual_pro_monat",
            "wert": 0.0025,
            "beschreibung": "0,25% Abschlag pro Monat",
            "max_abschlag": 0.12
          },
          "rechtsgrundlage": "§ 3 Abs. 4 VO"
        },
        "invalidenleistung": {
          "aktiviert": true,
          "voraussetzung": "berufsunfaehigkeit_mind_50_prozent",
          "hoehe": {
            "type": "conditional",
            "bedingung": {
              "field": "eintrittsdatum",
              "operator": "<",
              "parameter": "stichtag"
            },
            "if_true": {
              "type": "prozentual",
              "basis": "grundrente_monatlich",
              "faktor": 1.0,
              "beschreibung": "100% der Altersrente (Alt-Regelung)"
            },
            "if_false": {
              "type": "hochrechnung",
              "basis": "grundrente_monatlich",
              "beschreibung": "Linear von 0% auf 100% wachsend bis Regelalter"
            }
          },
          "wartezeit": {
            "jahre": 5,
            "beschreibung": "5 Jahre Wartezeit"
          },
          "rechtsgrundlage": "§ 4 Abs. 1 VO"
        },
        "todesfallleistung": {
          "beschreibung": "Mindestens 2 Jahre verheiratet",
          "witwenrente": {
            "aktiviert": true,
            "hoehe": {
              "type": "prozentual",
              "basis": "grundrente_monatlich",
              "faktor": 0.6,
              "beschreibung": "Witwenrente: 60% der Altersrente"
            },
            "dauer": "lebenslang",
            "rechtsgrundlage": "§ 5 Abs. 1 VO"
          },
          "waisenrente": {
            "aktiviert": true,
            "hoehe": {
              "type": "prozentual",
              "basis": "grundrente_monatlich",
              "faktor": 0.18,
              "beschreibung": "Waisenrente bis 25: 18% der Altersrente"
            },
            "max_alter": 25,
            "rechtsgrundlage": "§ 5 Abs. 2 VO"
          },
          "sterbegeld": {
            "aktiviert": true,
            "hoehe": {
              "type": "fest",
              "betrag": 3000.0,
              "beschreibung": "Sterbegeld: 3.000 EUR einmalig"
            },
            "zahlungsempfaenger": "erben",
            "rechtsgrundlage": "§ 5 Abs. 3 VO"
          }
        },
        "formula": {
          "type": "conditional",
          "condition": {
            "variable": "eintrittsdatum",
            "operator": "<",
            "parameter": "stichtag"
          },
          "if_true": {
            "type": "expression",
            "expression": "dienstjahre * satz_pro_jahr * mittlerer_teilzeitfaktor",
            "variables": [
              "dienstjahre",
              "mittlerer_teilzeitfaktor"
            ],
            "parameters": [
              "satz_pro_jahr"
            ]
          },
          "if_false": {
            "type": "expression",
            "expression": "letztes_gehalt * 12 * prozentsatz * dienstjahre",
            "variables": [
              "letztes_gehalt",
              "dienstjahre"
            ],
            "parameters": [
              "prozentsatz"
            ]
          }
        },
        "formel_anzeige": "Abhängig vom Eintrittsdatum (Stichtag: {stichtag})",
        "erklaerung": "Eintritt vor {stichtag}: Dienstjahre × {satz_pro_jahr} EUR × Teilzeit | Eintritt ab {stichtag}: Gehalt × 12 × {prozentsatz_prozent}% × Dienstjahre"
      }
    ]
  },
