    "insolvenzdatum": "2024-06-30"
  },
  "schema": {
    "schema_version": "2.0",
    "name": "ACME GmbH - Alt-Regelung",
    "input_fields": [
      {
        "id": "eintrittsdatum",
        "label": "Eintrittsdatum",
        "type": "date",
        "required": true,
        "category": "basis",
        "order": 1
      },
      {
        "id": "austrittsdatum",
        "label": "Austrittsdatum",
        "type": "date",
        "required": true,
        "category": "basis",
        "order": 2
      },
      {
        "id": "geburtsdatum",
        "label": "Geburtsdatum",
        "type": "date",
        "required": false,
        "category": "person",
        "order": 3
      },
      {
        "id": "mittlerer_teilzeitfaktor",
        "label": "Mittlerer Teilzeitfaktor",
        "type": "slider",
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "default": 1.0,
        "required": false,
        "category": "berechnung",
        "order": 4,
        "overridable": true,
        "help": "1.0 = Vollzeit, 0.8 = 80%, etc.",
        "visible_in": [
          "einfach"
        ]
      }
    ],
    "ui_layout": {
      "modes": [
        {
          "id": "einfach",
          "label": "Einfache Eingabe",
          "description": "Schnelle Eingabe ohne detaillierte Zeiträume",
          "fields": [
            "eintrittsdatum",
            "austrittsdatum",
            "geburtsdatum",
            "mittlerer_teilzeitfaktor"
          ]
        },
        {
          "id": "zeitraum",
          "label": "Zeitraum-Tabelle",
          "description": "Detaillierte Erfassung mit Zeiträumen",
          "fields": [
            "eintrittsdatum",
            "austrittsdatum"
          ],
          "zeitraum_tabelle": {
            "enabled": true,
            "beginn": {
              "type": "input",
              "input_id": "eintrittsdatum",
              "beschreibung": "Erfassungsbeginn"
            },
            "ende": {
              "type": "input",
              "input_id": "austrittsdatum",
              "beschreibung": "Erfassungsende"
            },
            "spalten": [
              {
                "id": "von",
                "label": "Von",
                "type": "date",
                "auto_calculated": true,
                "disabled": true,
                "width": 2
              },
              {
                "id": "bis",
                "label": "Bis",
                "type": "date",
                "required": true,
                "width": 2
              },
              {
                "id": "als_dienstzeit",
                "label": "Als Dienstzeit",
                "type": "checkbox",
                "default": true,
                "width": 1,
                "always_visible": true
              },
              {
                "id": "ggf",
                "label": "GGF",
                "type": "checkbox",
                "default": false,
                "always_visible": true,
                "help": "Gesellschafter-Geschäftsführer (zählt nicht für m)"
              },
              {
                "id": "teilzeitfaktor",
                "label": "Teilzeitfaktor",
                "type": "slider",
                "min": 0.0,
                "max": 1.0,
                "step": 0.05,
                "default": 1.0,
                "always_visible": true,
                "width": 2
              }
            ]
          }
        }
      ]
    },
    "leistungsteile": [
      {
        "id": "dienstjahre",
        "art": "Berechnungsgrundlage",
        "label": "Dienstjahre",
        "einheit": "Jahre",
        "overridable": true,
        "formula": {
          "type": "function",
          "function_id": "calculate_dienstjahre",
          "inputs": [
            "eintrittsdatum",
            "austrittsdatum",
            "geburtsdatum"
          ]
        }
      },
      {
        "id": "mittlerer_teilzeitfaktor",
        "art": "Berechnungsgrundlage",
        "label": "Mittlerer Teilzeitfaktor",
        "einheit": "Faktor",
        "overridable": true,
        "formula": {
          "type": "zeitraum_aggregation",
          "quelle": "zeitraeume",
          "feld": "teilzeitfaktor",
          "aggregation": "gewichteter_durchschnitt",
          "gewicht": "tage",
          "filter": {
            "feld": "als_dienstzeit",
            "wert": true
          },
          "fallback": {
            "type": "function",
            "function_id": "calculate_avg_teilzeit",
            "inputs": [
              "teilzeit_tabelle"
            ]
          }
        }
      },
      {
        "id": "grundrente_monatlich",
        "art": "Monatliche Rente vorschüssig",
        "label": "Grundrente",
        "einheit": "EUR/Monat",
        "overridable": true,
        "rechtsgrundlage": {
          "dokument": "Versorgungsordnung 1998",
          "paragraf": "§ 4 Abs. 1",
          "volltext": "Versorgungsordnung vom 01.01.1998 der ACME GmbH",
          "beschreibung": "Berechnung der Grundrente"
        },
        "erster_termin": {
          "type": "calculated",
          "beschreibung": "Erreichen der Regelaltersgrenze",
          "formel": {
            "type": "expression",
            "expression": "add_years(geburtsdatum, regelaltersgrenze)",
            "variables": [
              "geburtsdatum"
            ],
            "parameters": [
              "regelaltersgrenze"
            ]
          }
        },
        "anpassungsregeln": {
          "dynamisierung_vor_rentenbeginn": {
            "aktiviert": true,
            "beschreibung": "3-jährliche Anpassung gemäß VPI",
            "rechtsgrundlage": "§ 8 Abs. 1 VO"
          },
          "dynamisierung_ab_rentenbeginn": {
            "aktiviert": true,
            "beschreibung": "3-jährliche Anpassung gemäß VPI",
            "rechtsgrundlage": "§ 8 Abs. 2 VO"
          }
        },
        "vorzeitige_leistung": {
          "erlaubt": true,
          "beschreibung": "Ab Alter 63 möglich",
          "fruehester_termin": {
            "type": "calculated",
            "formel": {
              "type": "expression",
              "expression": "add_years(geburtsdatum, vorzeitige_altersgrenze)",
              "variables": [
                "geburtsdatum"
              ],
              "parameters": [
                "vorzeitige_altersgrenze"
              ]
            }
          },
          "abschlag": {
            "type": "prozentual_pro_monat",
            "wert": 0.003,
            "beschreibung": "0,3% Abschlag pro Monat"
          },
          "rechtsgrundlage": "§ 5 Abs. 3 VO"
        },
        "invalidenleistung": {
          "aktiviert": true,
          "voraussetzung": "berufsunfaehigkeit_mind_50_prozent",
          "hoehe": {
            "type": "prozentual",
            "basis": "grundrente_monatlich",
            "faktor": 1.0,
            "beschreibung": "100% der Altersrente"
          },
          "wartezeit": {
            "jahre": 5,
            "beschreibung": "5 Jahre Wartezeit"
          },
          "rechtsgrundlage": "§ 6 Abs. 1 VO"
        },
        "todesfallleistung": {
          "beschreibung": "keine Wartezeit",
          "witwenrente": {
            "aktiviert": true,
            "hoehe": {
              "type": "prozentual",
              "basis": "grundrente_monatlich",
              "faktor": 0.6,
              "beschreibung": "Witwenrente: 60% der Altersrente"
            },
            "dauer": "lebenslang",
            "rechtsgrundlage": "§ 7 Abs. 1 VO"
          },
          "waisenrente": {
            "aktiviert": true,
            "hoehe": {
              "type": "prozentual",
              "basis": "grundrente_monatlich",
              "faktor": 0.1,
              "beschreibung": "Waisenrente bis 25: 10% der Altersrente"
            },
            "max_alter": 25,
            "rechtsgrundlage": "§ 7 Abs. 2 VO"
          },
          "sterbegeld": {
            "aktiviert": false
          }
        },
        "formula": {
          "type": "expression",
          "expression": "dienstjahre * satz_pro_jahr * mittlerer_teilzeitfaktor",
          "variables": [
            "dienstjahre",
            "mittlerer_teilzeitfaktor"
          ],
          "parameters": [
            "satz_pro_jahr"
          ]
        },
        "formel_anzeige": "Dienstjahre × {satz_pro_jahr} EUR × Teilzeitfaktor",
        "erklaerung": "Pro Dienstjahr wird ein fester Satz gezahlt, angepasst an die durchschnittliche Teilzeit."
      }
    ]
  },
