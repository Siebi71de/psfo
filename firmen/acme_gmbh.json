            "von": "2001-01-01",
            "bis": "2017-12-31"
          },
          "mindestalter_bei_zusage": 25,
          "mindestdauer_jahre": 5,
          "rechtsgrundlage": "§ 30f Abs. 1 BetrAVG"
        },
        {
          "id": "alt_vor_2001",
          "beschreibung": "Zusage vor 01.01.2001: Mindestalter 35, Mindestdauer 10 Jahre (oder 12 Jahre Betriebszugehörigkeit)",
          "bedingung": {
            "type": "zusage_vor",
            "datum": "2001-01-01"
          },
          "mindestalter_bei_zusage": 35,
          "mindestdauer_jahre": 10,
          "alternativ_dienstjahre": 12,
