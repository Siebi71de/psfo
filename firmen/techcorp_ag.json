        "label": "Geburtsdatum",
        "type": "date",
        "required": false,
        "category": "person",
        "order": 3
      },
      {
        "id": "mittlerer_teilzeitfaktor",
        "label": "Mittlerer Teilzeitfaktor",
        "type": "slider",
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "default": 1.0,
        "required": false,
        "category": "berechnung",
        "order": 4,
        "overridable": true,
        "help": "1.0 = Vollzeit, 0.8 = 80%, etc.",
        "visible_in": [
          "einfach"
        ]
      },
      {
        "id": "letztes_gehalt",
        "label": "Letztes Gehalt (EUR/Monat)",
        "type": "number",
        "min": 0.0,
        "max": 50000.0,
        "step": 100.0,
        "default": 0.0,
        "required": true,
        "category": "berechnung",
        "order": 5,
        "help": "Monatliches Bruttogehalt",
        "visible_in": [
          "einfach"
        ]
      }
    ],
    "ui_layout": {
      "modes": [
        {
          "id": "einfach",
          "label": "Einfache Eingabe",
          "description": "Schnelle Eingabe ohne detaillierte Zeiträume",
          "fields": [
            "eintrittsdatum",
            "austrittsdatum",
            "geburtsdatum",
            "mittlerer_teilzeitfaktor",
            "letztes_gehalt"
          ]
        },
        {
          "id": "zeitraum",
          "label": "Zeitraum-Tabelle",
          "description": "Detaillierte Erfassung mit Zeiträumen",
          "fields": [
            "eintrittsdatum",
            "austrittsdatum"
          ],
          "zeitraum_tabelle": {
            "enabled": true,
            "beginn": {
              "type": "input",
              "input_id": "eintrittsdatum",
              "beschreibung": "Erfassungsbeginn"
            },
            "ende": {
              "type": "input",
              "input_id": "austrittsdatum",
              "beschreibung": "Erfassungsende"
            },
            "spalten": [
              {
                "id": "von",
                "label": "Von",
                "type": "date",
                "auto_calculated": true,
                "disabled": true,
                "width": 2
              },
              {
                "id": "bis",
                "label": "Bis",
                "type": "date",
                "required": true,
                "width": 2
              },
              {
                "id": "als_dienstzeit",
                "label": "Als Dienstzeit",
                "type": "checkbox",
                "default": true,
                "width": 1,
                "always_visible": true
              },
              {
                "id": "ggf",
                "label": "GGF",
                "type": "checkbox",
                "default": false,
                "always_visible": true,
                "help": "Gesellschafter-Geschäftsführer (zählt nicht für m)"
              },
              {
                "id": "teilzeitfaktor",
                "label": "Teilzeitfaktor",
                "type": "slider",
                "min": 0.0,
                "max": 1.0,
                "step": 0.05,
                "default": 1.0,
                "always_visible": true,
                "width": 2
              },
              {
                "id": "tarifgruppe",
                "label": "TG",
                "type": "dropdown",
                "options": [
                  {
                    "value": "TG_A",
                    "label": "TG A",
                    "faktor": 1
                  },
                  {
                    "value": "TG_B",
                    "label": "TG B",
                    "faktor": 2
                  },
                  {
                    "value": "TG_C",
                    "label": "TG C",
                    "faktor": 3
                  },
                  {
                    "value": "TG_D",
                    "label": "TG D",
                    "faktor": 5
                  },
                  {
                    "value": "TG_E",
                    "label": "TG E",
                    "faktor": 10
                  }
                ],
                "default": "TG_C",
                "always_visible": true,
                "help": "Tarifgruppe bestimmt den Rentenfaktor (€/Monat)"
              },
              {
                "id": "bonus",
                "label": "Bonus %",
                "type": "number",
                "min": 0,
                "max": 100,
                "default": 0,
                "step": 5,
                "always_visible": false,
                "conditional": {
                  "field": "tarifgruppe",
                  "operator": "in",
                  "value": [
                    "TG_D",
                    "TG_E"
                  ]
                },
                "help": "Zusätzlicher Bonus nur für TG D und E"
              }
            ]
          }
        }
      ]
    },
    "leistungsteile": [
      {
        "id": "dienstjahre",
        "art": "Berechnungsgrundlage",
        "label": "Dienstjahre",
        "einheit": "Jahre",
        "overridable": true,
        "formula": {
          "type": "function",
          "function_id": "calculate_dienstjahre",
          "inputs": [
            "eintrittsdatum",
            "austrittsdatum",
            "geburtsdatum"
          ]
        }
      },
      {
        "id": "mittlerer_teilzeitfaktor",
        "art": "Berechnungsgrundlage",
        "label": "Mittlerer Teilzeitfaktor",
        "einheit": "Faktor",
        "overridable": true,
        "formula": {
          "type": "zeitraum_aggregation",
          "quelle": "zeitraeume",
          "feld": "teilzeitfaktor",
          "aggregation": "gewichteter_durchschnitt",
          "gewicht": "tage",
          "filter": {
            "feld": "als_dienstzeit",
            "wert": true
          },
          "fallback": {
            "type": "constant",
            "value": 1.0
          }
        }
      },
      {
        "id": "grundrente_monatlich",
        "art": "Monatliche Rente vorschüssig",
        "label": "Grundrente",
        "einheit": "EUR/Monat",
        "overridable": true,
        "rechtsgrundlage": {
          "dokument": "Versorgungsordnung 2015",
          "paragraf": "§ 3 Abs. 1",
          "volltext": "Versorgungsordnung vom 01.01.2015 der TechCorp AG",
          "beschreibung": "Berechnung der Grundrente nach Gehaltsformel"
        },
        "erster_termin": {
          "type": "calculated",
          "beschreibung": "Erreichen der Regelaltersgrenze",
          "formel": {
            "type": "expression",
            "expression": "add_years(geburtsdatum, regelaltersgrenze)",
            "variables": [
              "geburtsdatum"
            ],
            "parameters": [
              "regelaltersgrenze"
            ]
          }
        },
        "anpassungsregeln": {
          "dynamisierung_vor_rentenbeginn": {
            "aktiviert": true,
            "beschreibung": "Jährliche Anpassung gemäß Gehaltsentwicklung",
            "rechtsgrundlage": "§ 9 Abs. 1 VO"
          },
          "dynamisierung_ab_rentenbeginn": {
            "aktiviert": true,
            "beschreibung": "Jährliche Anpassung 1–5% gemäß Gehaltsentwicklung",
            "rechtsgrundlage": "§ 9 Abs. 2 VO"
          },
          "mindestrente": {
            "aktiviert": true,
            "betrag": 400.0,
            "beschreibung": "Garantierte Mindestrente von 400 EUR/Monat"
          }
        },
        "vorzeitige_leistung": {
          "erlaubt": true,
          "beschreibung": "Ab Alter 63 möglich",
          "fruehester_termin": {
            "type": "calculated",
            "formel": {
              "type": "expression",
              "expression": "add_years(geburtsdatum, vorzeitige_altersgrenze)",
              "variables": [
                "geburtsdatum"
              ],
              "parameters": [
                "vorzeitige_altersgrenze"
              ]
            }
          },
          "abschlag": {
            "type": "prozentual_pro_jahr",
            "wert": 0.036,
            "beschreibung": "3,6% Abschlag pro Jahr",
            "max_abschlag": 0.144
          },
          "rechtsgrundlage": "§ 4 Abs. 2 VO"
        },
        "invalidenleistung": {
          "aktiviert": true,
          "voraussetzung": "erwerbsunfaehigkeit_voll",
          "hoehe": {
            "type": "hochrechnung",
            "basis": "grundrente_monatlich",
            "beschreibung": "Hochrechnung bis Regelaltersgrenze"
          },
          "wartezeit": {
            "jahre": 3,
            "beschreibung": "3 Jahre Wartezeit"
          },
          "rechtsgrundlage": "§ 5 Abs. 1 VO"
        },
        "todesfallleistung": {
          "beschreibung": "Mindestens 1 Jahr verheiratet",
          "witwenrente": {
            "aktiviert": true,
            "hoehe": {
              "type": "prozentual",
              "basis": "grundrente_monatlich",
              "faktor": 0.55,
              "beschreibung": "Witwenrente: 55% der Altersrente"
            },
            "dauer": "lebenslang",
            "rechtsgrundlage": "§ 6 Abs. 1 VO"
          },
          "waisenrente": {
            "aktiviert": true,
            "hoehe": {
              "type": "prozentual",
              "basis": "grundrente_monatlich",
              "faktor": 0.15,
              "beschreibung": "Waisenrente bis 27: 15% der Altersrente"
            },
            "max_alter": 27,
            "rechtsgrundlage": "§ 6 Abs. 2 VO"
          }
        },
        "formula": {
          "type": "expression",
          "expression": "letztes_gehalt * 12 * prozentsatz * dienstjahre",
          "variables": [
            "letztes_gehalt",
            "dienstjahre"
          ],
          "parameters": [
            "prozentsatz"
          ]
        },
        "formel_anzeige": "Letztes Gehalt × 12 × {prozentsatz_prozent}% × Dienstjahre",
        "erklaerung": "Pro Dienstjahr wird ein Prozentsatz des Jahresgehalts als Rente gezahlt."
      },
      {
        "id": "sterbegeld",
        "art": "Einmalige Todesfallleistung",
        "label": "Sterbegeld",
        "einheit": "EUR einmalig",
        "overridable": false,
        "rechtsgrundlage": {
          "dokument": "Versorgungsordnung 2015",
          "paragraf": "§ 7 Abs. 1",
          "volltext": "Versorgungsordnung vom 01.01.2015 der TechCorp AG",
          "beschreibung": "Einmaliges Sterbegeld an Hinterbliebene"
        },
        "erster_termin": {
          "type": "event",
          "ereignis": "todesfall",
          "beschreibung": "Zahlung im Todesfall"
        },
        "invalidenleistung": {
          "aktiviert": false
        },
        "vorzeitige_leistung": {
          "erlaubt": false
        },
        "todesfallleistung": {
          "beschreibung": "1 Jahr Betriebszugehörigkeit Wartezeit",
          "sterbegeld": {
            "aktiviert": true,
            "hoehe": {
              "type": "fest",
              "betrag": 50000.0,
              "beschreibung": "50.000 EUR einmalig"
            },
            "zahlungsempfaenger": "Ehepartner, sonst Kinder, sonst Eltern, sonst Erben",
            "rechtsgrundlage": "§ 7 Abs. 1 VO"
          }
        },
        "formula": {
          "type": "constant",
          "value": 50000.0
        },
        "formel_anzeige": "Fester Betrag: 50.000 EUR",
        "erklaerung": "Einmalige Kapitalleistung im Todesfall."
      }
    ]
